{
  "commands": [
    "apt-get update -y",
    "apt-get install -y curl unzip",
    "rm -rf /tmp/aws /tmp/awscliv2.zip",
    "curl -L https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o /tmp/awscliv2.zip",
    "unzip -q /tmp/awscliv2.zip -d /tmp",
    "/tmp/aws/install --update",
    "aws --version",
    "docker --version"
  ]
}
